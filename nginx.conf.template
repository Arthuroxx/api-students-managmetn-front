# nginx server template for the Student Management frontend.
# Adds the single-page-application fallback, cache headers, compression, and security headers.
#
# This file is a template: the official nginx image substitutes ${API_BASE_URL} at container
# start and writes the result to /etc/nginx/conf.d/default.conf. An empty value keeps
# `connect-src 'self'` (same origin); a separate API origin is appended to it.
# See docs/deployment.md and docs/configuration.md.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Compression for text-based assets.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        image/svg+xml;

    # Security headers. These are inherited by every location that does not define its own
    # `add_header` directive, which is why caching below uses `expires` where possible.
    # Enable HTTP Strict Transport Security at the TLS terminator.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${API_BASE_URL}; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # Hashed build assets are immutable. `expires` alone cannot emit `immutable`, so this
    # location adds its own headers and must repeat the security headers above.
    location ~* \.(?:js|css|woff2?|svg|png|jpg|jpeg|gif|ico|webp)$ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${API_BASE_URL}; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        try_files $uri =404;
    }

    # The entry document and the crawler file must be revalidated. `expires -1` sets
    # `Cache-Control: no-cache` without its own `add_header`, so the security headers still apply.
    location = /index.html {
        expires -1;
    }

    location = /robots.txt {
        expires -1;
    }

    # Single-page-application fallback: unknown paths resolve to the app shell.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
